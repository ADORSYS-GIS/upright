# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.
# The image publishing workflow reads these rules with Moby's Docker-compatible
# pattern matcher. Dockerfile, .dockerignore, and .github/image-build-args are
# explicit image inputs.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore CI service files.
/.github

# Local toolchain and lint configuration.
/.ruby-version
/mise.toml
/.rubocop.yml

# Development and CI-only executables/configuration.
/bin/brakeman
/bin/bundler-audit
/bin/ci
/bin/dev
/bin/importmap
/bin/kamal
/bin/rubocop
/bin/setup
/config/bundler-audit.yml
/config/ci.rb

# Helm chart is not needed inside the Rails image.
/charts

# Ignore Kamal files.
/config/deploy*.yml
/.kamal

# Ignore development files
/.devcontainer

# Ignore Docker-related files
/.dockerignore
/Dockerfile*

# Repository-only files. The image build and the running container do not
# read them. Database migrations under db/ stay in the image.
/test/
/README*
/docker-compose.yml
/Procfile.dev
/docker/
