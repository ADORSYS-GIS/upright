ADMIN_PASSWORD=admin
SITE_SUBDOMAIN=fra
# Optional locally. Required in production (from the secret store).
# PROMETHEUS_OTLP_TOKEN=
# Local Alertmanager reads this. Do not commit the URL.
DISCORD_WEBHOOK_URL=
# Keycloak user for the DATEV issuer Playwright probe (realm oid4vc-vci).
# Required when running that browser journey locally. Production maps these
# from UPRIGHT_KEYCLOAK_OID4VC_* in datev-wallet-secrets.
# KEYCLOAK_OID4VC_USERNAME=
# KEYCLOAK_OID4VC_PASSWORD=
